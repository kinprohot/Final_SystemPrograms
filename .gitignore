test_output/
test_results.txt
*.tmp
*.temp
*.log
*.swp
*.swo
*~
.*.swp
.*.swo
scenarios/output/

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

