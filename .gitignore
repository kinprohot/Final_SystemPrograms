*.obj
*.lo
*.slo
*.a
*.so
*.so.*
*.dylib
*.dll
*.lib

# Compiled binaries & executables
memory_allocator
memory_allocator.exe
*.exe
*.out
a.out

# Build directories
build/
bin/
obj/
dist/
.deps/

# Debugging & profiling symbols
*.dSYM/
*.su
*.idb
*.pdb
core
core.*
vgcore.*
valgrind-out.txt
